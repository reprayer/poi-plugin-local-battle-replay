{
  "name": "poi-plugin-local-battle-replay",
  "version": "1.0.0",
  "description": "Local minimalist KanColle battle replay for poi",
  "author": "reprayer",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reprayer/poi-plugin-local-battle-replay.git"
  },
  "bugs": {
    "url": "https://github.com/reprayer/poi-plugin-local-battle-replay/issues"
  },
  "homepage": "https://github.com/reprayer/poi-plugin-local-battle-replay#readme",
  "keywords": [
    "poi-plugin",
    "kancolle",
    "battle-replay"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "audit:network": "node scripts/audit-network.js",
    "check": "npm run test && npm run audit:network",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "index.js",
    "src/",
    "styles/",
    "standalone/",
    "examples/",
    "README.md",
    "REFERENCES.md",
    "LICENSE"
  ],
  "poiPlugin": {
    "title": "本地战斗回放",
    "description": "极简线条版战斗流程播放器",
    "icon": "fa/play-circle",
    "priority": 2,
    "earliestCompatibleMain": "11.1.0"
  }
}
